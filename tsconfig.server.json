{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "vite/client"]
  },
  "include": ["functions", "server", "src/inschrijving/api.ts", "src/inschrijving/evenementen.ts", "src/inschrijving/periode.ts", "src/content/event.ts", "src/gps/api.ts"]
}
